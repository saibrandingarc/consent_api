{
  "name": "consent_api",
  "version": "0.1.0",
  "private": true,
  "author": "saibrandingarc",
  "description": "Consent Management NestJS API",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @cmp/types build && pnpm --filter @cmp/config build && pnpm --filter @cmp/utils build && pnpm --filter @cmp/validation build && pnpm --filter @cmp/auth build && pnpm --filter @cmp/sdk build && pnpm --filter @cmp/database generate && pnpm --filter @cmp/database build && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "playwright:install": "playwright install chromium",
    "scan:homepage-probe": "tsx scripts/homepage-scan-probe.ts",
    "db:generate": "pnpm --filter @cmp/database generate",
    "db:migrate": "pnpm --filter @cmp/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @cmp/database migrate:deploy",
    "db:seed": "pnpm --filter @cmp/database seed"
  },
  "dependencies": {
    "@cmp/auth": "workspace:*",
    "@cmp/config": "workspace:*",
    "@cmp/database": "workspace:*",
    "@cmp/sdk": "workspace:*",
    "@cmp/types": "workspace:*",
    "@cmp/utils": "workspace:*",
    "@cmp/validation": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "7.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
