# Azure API App Service. Stack: Node 22 LTS. Startup: npm start (node dist/main.js).
NODE_ENV=production
WEB_URL=https://YOUR-WEB.azurewebsites.net
ADMIN_URL=https://YOUR-ADMIN.azurewebsites.net
API_PUBLIC_URL=https://YOUR-API.azurewebsites.net/api/v1
CM_DATABASE_URL=sqlserver://HOST:1433;database=consent_mngt_dev;user=USER;password={PASSWORD};encrypt=true;trustServerCertificate=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER_URL=
EMAIL_VERIFICATION_ENABLED=false
DOMAIN_AUTO_VERIFY=true
